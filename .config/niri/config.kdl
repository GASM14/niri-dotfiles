environment {
    QT_QPA_PLATFORMTHEME "qt5ct"
    QT_STYLE_OVERRIDE "kvantum"
}

// Animações suaves
animations {
    slowdown 1.0
    
    workspace-switch {
        spring damping-ratio=0.7 stiffness=800 epsilon=0.0001
    }
    
    window-open {
        spring damping-ratio=0.6 stiffness=400 epsilon=0.001
    }
    
    window-close {
        spring damping-ratio=0.6 stiffness=400 epsilon=0.001
    }
    
    window-movement {
        spring damping-ratio=0.8 stiffness=800 epsilon=0.0001
    }
    
    window-resize {
        spring damping-ratio=0.8 stiffness=800 epsilon=0.0001
    }
}

input {
    keyboard {
        xkb {
            layout "pt"
        }
    }

    touchpad {
        tap
        dwt
        natural-scroll
        accel-speed 0.2
        accel-profile "adaptive"
        click-method "clickfinger"
        scroll-method "two-finger"
    }
}

// Idle management: lock after 10min, suspend after 15min

// Check the wiki for a full description of the configuration:
//   https://yalter.github.io/niri/Configuration:-Introduction

// ----------------------------------------------------------------------------
// Launch at startup
// ----------------------------------------------------------------------------

// spawn-at-startup "sh" "-c" "wl-paste --watch cliphist store"
spawn-at-startup "/home/goncalom/.local/bin/wallpaper-restore"
spawn-at-startup "sh" "-c" "swayidle -w timeout 600 'lock-screen' timeout 900 'systemctl suspend' resume 'lock-screen' before-sleep 'lock-screen'"
spawn-at-startup "nm-applet" "--indicator"

// ----------------------------------------------------------------------------
// Behaviors and aesthetics
// ----------------------------------------------------------------------------

// Avoid writing screenshots to disk since they get piped into satty.
screenshot-path "~/Pictures/Screenshots/"

hotkey-overlay {
    // Avoid auto-showing the important hotkeys menu.
    skip-at-startup
}

gestures {
    // Disable overview when mousing over the top left of primary screen.
    hot-corners {
        off
    }
}

// Remove window decorations (requires opening and closing each app to change).
prefer-no-csd

layout {
    // Set gaps around windows in logical pixels.
    gaps 8

    focus-ring {
        width 1
    }
    
    shadow {
        on
        softness 20
        spread 3
        offset x=0 y=4
        color "#000000aa"
    }
}

// ----------------------------------------------------------------------------
// Window / layer rules
// ----------------------------------------------------------------------------

window-rule {
    // Slight rounded corners.
    geometry-corner-radius 2
    clip-to-geometry true
}

// Assorted window rules.
window-rule {
    match app-id=r#"^Pinentry-gtk$"#
    match app-id=r#"^Tk$"#
    match app-id=r#"^gimp$"# title=r#"Preferences"#
    match app-id=r#"^mpv$"#
    match app-id=r#"^soffice$"# title=r#"^Text Import"#
    match app-id=r#"^thunar$"# title=r#"^Rename "#
    match app-id=r#"^virt-manager$"# title=r#" - Connection Details"#
    match app-id=r#"^wev$"#
    match app-id=r#"^xarchiver$"#
    match app-id=r#"firefox$"# title=r#"^(Picture-in-Picture|Library|About Mozilla Firefox|Firefox - Choose a profile)$"#

    open-floating true
}

window-rule {
    match app-id=r#"^dfr\.floating\.ghostty$"#
    match app-id=r#"^dfr\.floating\.thunar$"#

    open-floating true
    default-column-width { proportion 0.33; }
    default-window-height { proportion 0.5; }
}

window-rule {
    match app-id=r#"^com\.gabm\.satty$"#
    open-floating true
    min-width 730
    min-height 300
}

window-rule {
    match app-id=r#"^KeePassXC$"#

    block-out-from "screencast"
}

// ----------------------------------------------------------------------------
// Key binds
// ----------------------------------------------------------------------------


// Transparência para apps
window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    opacity 0.85
}

window-rule {
    match app-id=r#"^org\.pwmt\.zathura$"#
    opacity 0.90
}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}


// Transparência universal subtil (toggle funciona em qualquer janela)
window-rule {
    opacity 0.96
}

spawn-at-startup "lxqt-policykit"

spawn-at-startup "copyq"

// CopyQ clipboard manager (floating)
window-rule {
    match app-id="copyq"
    open-floating true
}

binds {
    Mod+Alt+D  hotkey-overlay-title="Document viewer" { spawn "zathura"; }
    Mod+Alt+I  hotkey-overlay-title="Image viewer" { spawn "imv"; }

    Mod+F1  hotkey-overlay-title="Cheatsheet" { show-hotkey-overlay; }

    Mod+Ctrl+T hotkey-overlay-title="Toggle window transparency" { toggle-window-rule-opacity; }

    Mod+Shift+W hotkey-overlay-title="Cycle wallpaper" { spawn "/home/goncalom/.local/bin/wallpaper-cycle"; }

    Mod+Space repeat=false hotkey-overlay-title="App launcher" { spawn "fuzzel"; }


    // Overview.
    Mod+Shift+M        hotkey-overlay-title="System menu" { spawn "dfr-menu"; }
    Mod+F2             hotkey-overlay-title="Search niri keybinds" { spawn "fuzzel"; }
    Mod+F3             hotkey-overlay-title="Search niri actions" { spawn "fuzzel"; }
    Mod+F4             hotkey-overlay-title="Search Waybar actions" { spawn "fuzzel"; }
    Mod+O repeat=false hotkey-overlay-title="Toggle overview (4-finger swipe)" { toggle-overview; }

    // System.
    Mod+Alt+L        hotkey-overlay-title="Lock screen" { spawn "swaylock"; }
    Mod+Shift+Alt+L  hotkey-overlay-title="Power off monitors" { power-off-monitors; }
    Mod+Ctrl+Shift+Q hotkey-overlay-title="Exit niri session" { quit; }

    // Capture.
    Mod+S            hotkey-overlay-title="Screenshot (region)" { screenshot; }
    Mod+Shift+S      hotkey-overlay-title="Screenshot (window)" { screenshot-window; }
    Mod+Ctrl+S       hotkey-overlay-title="Screenshot (monitor: focused)" { screenshot-screen; }
    Mod+Ctrl+Shift+S hotkey-overlay-title="Screenshot (monitor: all)" { screenshot-screen; }

    Mod+P       hotkey-overlay-title="Pick window" { spawn "ghostty" "--class=dfr.floating.ghostty" "-e" "sh" "-c" "printf 'Pick a window...\n\n'; niri msg pick-window; niri msg action focus-window-previous; printf '\nDone! Press CTRL+c to quit\n'; read"; }
//     Mod+Shift+P hotkey-overlay-title="Pick color" { spawn-sh "killall hyprpicker || hyprpicker --autocopy --lowercase-hex"; }

    Mod+E hotkey-overlay-title="Cast focused window" { spawn-sh "niri msg action set-dynamic-cast-window --id $(niri msg --json focused-window | jq .id)"; }

    // Notifications.
    Mod+N            hotkey-overlay-title="Show last notification" { spawn "makoctl" "restore"; }
    Mod+Shift+N      hotkey-overlay-title="Dismiss last notification" { spawn "makoctl" "dismiss"; }
    Mod+Ctrl+N       hotkey-overlay-title="Dismiss all notifications" { spawn "makoctl" "dismiss" "--all"; }
    Mod+Ctrl+Shift+N hotkey-overlay-title="Toggle silencing notifications" { spawn "dfr-toggle-notifications"; }

    // Themes.
    Mod+BackSlash            hotkey-overlay-title="Cycle theme's wallpapers" { spawn "dfr-theme-set-bg"; }
    Mod+Shift+BackSlash      hotkey-overlay-title="Pick theme's wallpapers" { spawn "dfr-theme-set-bg" "--menu"; }
    Mod+Ctrl+BackSlash       hotkey-overlay-title="Cycle themes" { spawn "dfr-theme-set"; }
    Mod+Ctrl+Shift+BackSlash hotkey-overlay-title="Pick theme" { spawn "dfr-theme-set" "--menu"; }


    // Screenshots (estilo KDE Spectacle)
    Print           hotkey-overlay-title="Screenshot menu (PrtSc)" { spawn "/home/goncalom/.local/bin/screenshot-menu"; }
    Shift+Print     hotkey-overlay-title="Screenshot region to clipboard" { spawn "sh" "-c" "grim -g \"$(slurp)\" - | wl-copy --type image/png && notify-send 'Screenshot' 'Copiado para clipboard' --icon=edit-copy"; }
    Ctrl+Print      hotkey-overlay-title="Screenshot fullscreen" { spawn "sh" "-c" "grim \"$HOME/Pictures/Screenshots/screen_$(date +%Y%m%d_%H%M%S).png\" && notify-send 'Screenshot' 'Ecrã guardado' --icon=camera-photo"; }
    Alt+Print       hotkey-overlay-title="Edit screenshot" { spawn "sh" "-c" "FILE=\"$HOME/Pictures/Screenshots/edit_$(date +%Y%m%d_%H%M%S).png\"; grim -g \"$(slurp)\" \"$FILE\" && (command -v kolourpaint >/dev/null 2>&1 && kolourpaint \"$FILE\" || xdg-open \"$FILE\") &"; }

    // Media keys.
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Raise volume" { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05+"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Lower volume" { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"; }
    XF86AudioMute        allow-when-locked=true hotkey-overlay-title="Mute playback" { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true hotkey-overlay-title="Mute microphone"{ spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    XF86AudioPlay       allow-when-locked=true hotkey-overlay-title="Play / pause track" { spawn "playerctl" "play-pause"; }
    XF86AudioStop       allow-when-locked=true hotkey-overlay-title="Stop track" { spawn "playerctl" "stop"; }
    XF86AudioPrev       allow-when-locked=true hotkey-overlay-title="Previous track" { spawn "playerctl" "previous"; }
    XF86AudioNext       allow-when-locked=true hotkey-overlay-title="Next track" { spawn "playerctl" "next"; }
    Shift+XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Seek -10 seconds" { spawn "playerctl" "position" "10-"; }
    Shift+XF86AudioNext allow-when-locked=true hotkey-overlay-title="Seek +10 seconds" { spawn "playerctl" "position" "10+"; }

    XF86MonBrightnessUp   allow-when-locked=true hotkey-overlay-title="Increase brightness" { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Decrease brightness" { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }

    XF86Calculator repeat=false hotkey-overlay-title="Launcher (calculator)" { spawn "fuzzel"; }

    // Launcher.
    Mod+W      repeat=false hotkey-overlay-title="Window overview" { toggle-overview; }
    Mod+V      repeat=false hotkey-overlay-title="Clipboard history" { spawn "sh" "-c" "cliphist list | fuzzel --dmenu --prompt=clip | cliphist decode | wl-copy"; }

    // Apps.
    Mod+Alt+H            hotkey-overlay-title="System health" { spawn "dfr-launch-or-focus-tui" "monitor"; }
    Mod+Alt+T            hotkey-overlay-title="Terminal" { spawn "ghostty"; }
    Mod+Alt+Shift+T      hotkey-overlay-title="Terminal (floating)" { spawn "ghostty" "--class=dfr.floating.ghostty"; }
    Mod+Alt+F            hotkey-overlay-title="File manager" { spawn "thunar"; }
    Mod+Alt+Shift+F      hotkey-overlay-title="File manager (floating)" { spawn "thunar" "--name=dfr.floating.thunar"; }
    Mod+Alt+N            hotkey-overlay-title="Notes" { spawn "dfr-launch-or-focus-tui" "notes"; }
    Mod+Alt+Shift+N      hotkey-overlay-title="Notes (directory)" { spawn-sh "dfr-launch-or-focus-tui ${EDITOR} ${NOTES_DIRECTORY}"; }
    Mod+Alt+P            hotkey-overlay-title="Passwords" { spawn "dfr-launch-or-focus" "keepassxc"; }
    Mod+Alt+Shift+P      hotkey-overlay-title="Generate random password to clipboard" { spawn "pw"; }
    Mod+Alt+M            hotkey-overlay-title="Music" { spawn "dfr-launch-or-focus-tui" "rmpc"; }
    Mod+Alt+B            hotkey-overlay-title="Browser" { spawn "/home/goncalom/AppImages/helium.appimage"; }
    Mod+Alt+Shift+B      hotkey-overlay-title="Browser (private)" { spawn "/home/goncalom/AppImages/helium.appimage" "--incognito"; }
    Mod+Alt+Ctrl+Shift+B hotkey-overlay-title="Browser (isolated profile)" { spawn-sh "firefox -P ${BROWSER_ISOLATED_PROFILE:-isolated}"; }

    // Display scaling / zoom.
    Mod+Ctrl+Shift+Equal hotkey-overlay-title="Increase focused monitor scale" { spawn "output-scale" "+"; }
    Mod+Ctrl+Shift+Minus hotkey-overlay-title="Decrease focused monitor scale" { spawn "output-scale" "-"; }
    Mod+Ctrl+Shift+0     hotkey-overlay-title="Reset focused monitor scale" { spawn "output-scale" "1.0"; }

    // Window and column behavior.
    Mod+Q repeat=false hotkey-overlay-title="Close window" { close-window; }

    Mod+C      hotkey-overlay-title="Center column" { center-column; }
    Mod+Ctrl+C hotkey-overlay-title="Center all visible columns" { center-visible-columns; }

    Mod+Z      hotkey-overlay-title="Toggle floating window" { toggle-window-floating; }
    Mod+Ctrl+Z hotkey-overlay-title="Switch focus between floating and tiling"{ switch-focus-between-floating-and-tiling; }

    Mod+T hotkey-overlay-title="Toggle tabbed column" { toggle-column-tabbed-display; }

    Mod+BracketLeft  hotkey-overlay-title="Move focused window in and out of column to the left" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Move focused window in and out of column to the right" { consume-or-expel-window-right; }
    Mod+Comma        hotkey-overlay-title="Move right window under focused column" { consume-window-into-column; }
    Mod+Period       hotkey-overlay-title="Remove bottom window from focused column" { expel-window-from-column; }

    // Window and column sizes.
    Mod+F       hotkey-overlay-title="Maximize column" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="Full screen window" { fullscreen-window; }
    Mod+Ctrl+F  hotkey-overlay-title="Fill empty column space" { expand-column-to-available-width; }

    Mod+R       hotkey-overlay-title="Cycle preset widths" { switch-preset-column-width; }
    Mod+Shift+R hotkey-overlay-title="Cycle preset heights" { switch-preset-window-height; }
    Mod+Ctrl+R  hotkey-overlay-title="Reset window height" { reset-window-height; }

    Mod+Equal       hotkey-overlay-title="Increase column width" { set-column-width "+10%"; }
    Mod+Minus       hotkey-overlay-title="Decrease column width" { set-column-width "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title="Increase window height" { set-window-height "+10%"; }
    Mod+Shift+Minus hotkey-overlay-title="Decrease window height" { set-window-height "-10%"; }

    // Window and column movement.
    Mod+I hotkey-overlay-title="Focus previously focused window" { focus-window-previous; }

    Mod+Left  hotkey-overlay-title="Focus column left" { focus-column-left; }
    Mod+Down  hotkey-overlay-title="Focus column down" { focus-window-down; }
    Mod+Up    hotkey-overlay-title="Focus column up" { focus-window-up; }
    Mod+Right hotkey-overlay-title="Focus column right" { focus-column-right; }
    Mod+H     hotkey-overlay-title="Focus column left" { focus-column-left; }
    Mod+J     hotkey-overlay-title="Focus column down" { focus-window-down; }
    Mod+K     hotkey-overlay-title="Focus column up" { focus-window-up; }
    Mod+L     hotkey-overlay-title="Focus column down" { focus-column-right; }

    Mod+Ctrl+Left  hotkey-overlay-title="Move column left" { move-column-left; }
    Mod+Ctrl+Down  hotkey-overlay-title="Move column down" { move-window-down; }
    Mod+Ctrl+Up    hotkey-overlay-title="Move column up" { move-window-up; }
    Mod+Ctrl+Right hotkey-overlay-title="Move column right" { move-column-right; }
    Mod+Ctrl+H     hotkey-overlay-title="Move column left" { move-column-left; }
    Mod+Ctrl+J     hotkey-overlay-title="Move column down" { move-window-down; }
    Mod+Ctrl+K     hotkey-overlay-title="Move column up" { move-window-up; }
    Mod+Ctrl+L     hotkey-overlay-title="Move column down" { move-column-right; }

    Mod+G              hotkey-overlay-title="Focus first column" { focus-column-first; }
    Mod+SemiColon      hotkey-overlay-title="Focus last column" { focus-column-last; }
    Mod+Ctrl+G         hotkey-overlay-title="Move column to first" { move-column-to-first; }
    Mod+Ctrl+SemiColon hotkey-overlay-title="Move column to last" { move-column-to-last; }
    Mod+Home           hotkey-overlay-title="Focus first column" { focus-column-first; }
    Mod+End            hotkey-overlay-title="Focus last column" { focus-column-last; }
    Mod+Ctrl+Home      hotkey-overlay-title="Move column to first" { move-column-to-first; }
    Mod+Ctrl+End       hotkey-overlay-title="Move column to last" { move-column-to-last; }

    Mod+WheelScrollDown       hotkey-overlay-title="Focus column right" { focus-column-right; }
    Mod+WheelScrollUp         hotkey-overlay-title="Focus column left" { focus-column-left; }
    Mod+Ctrl+WheelScrollDown  hotkey-overlay-title="Move column right" { move-column-right; }
    Mod+Ctrl+WheelScrollUp    hotkey-overlay-title="Move column left" { move-column-left; }
    Mod+WheelScrollRight      hotkey-overlay-title="Focus column right" { focus-column-right; }
    Mod+WheelScrollLeft       hotkey-overlay-title="Focus column left" { focus-column-left; }
    Mod+Ctrl+WheelScrollRight hotkey-overlay-title="Move column right" { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  hotkey-overlay-title="Move column left" { move-column-left; }

    // Multiple monitor window and column movement.
    Mod+Ctrl+Shift+Left  hotkey-overlay-title="Move column to left monitor" { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Down  hotkey-overlay-title="Move column to lower monitor" { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+Up    hotkey-overlay-title="Move column to upper monitor" { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Right hotkey-overlay-title="Move column to right monitor" { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+H     hotkey-overlay-title="Move column to left monitor" { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+J     hotkey-overlay-title="Move column to lower monitor" { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+K     hotkey-overlay-title="Move column to upper monitor" { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+L     hotkey-overlay-title="Move column to right monitor" { move-column-to-monitor-right; }

    Mod+MouseBack               hotkey-overlay-title="Focus left monitor" { focus-monitor-left; }
    Mod+MouseForward            hotkey-overlay-title="Focus right monitor" { focus-monitor-right; }
    Mod+Ctrl+Shift+MouseBack    hotkey-overlay-title="Move column to left monitor" { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+MouseForward hotkey-overlay-title="Move column to right monitor" { move-column-to-monitor-right; }

    // Workspaces.
    Mod+Shift+WheelScrollDown      cooldown-ms=150 hotkey-overlay-title="Focus next workspace" { focus-workspace-down; }
    Mod+Shift+WheelScrollUp        cooldown-ms=150 hotkey-overlay-title="Focus previous workspace" { focus-workspace-up; }
    Mod+Ctrl+Shift+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="Move column to next workspace" { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+WheelScrollUp   cooldown-ms=150 hotkey-overlay-title="Move column to previous workspace" { move-column-to-workspace-up; }

    Mod+D               hotkey-overlay-title="Focus next workspace" { focus-workspace-down; }
    Mod+U               hotkey-overlay-title="Focus previous workspace" { focus-workspace-up; }
    Mod+Page_Down       hotkey-overlay-title="Focus next workspace" { focus-workspace-down; }
    Mod+Page_Up         hotkey-overlay-title="Focus previous workspace" { focus-workspace-up; }
    Mod+Ctrl+D          hotkey-overlay-title="Move column to next workspace" { move-column-to-workspace-down; }
    Mod+Ctrl+U          hotkey-overlay-title="Move column to previous workspace" { move-column-to-workspace-up; }
    Mod+Ctrl+Page_Down  hotkey-overlay-title="Move column to next workspace" { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up    hotkey-overlay-title="Move column to previous workspace" { move-column-to-workspace-up; }
    Mod+Shift+D         hotkey-overlay-title="Move workspace down" { move-workspace-down; }
    Mod+Shift+U         hotkey-overlay-title="Move workspace up" { move-workspace-up; }
    Mod+Shift+Page_Down hotkey-overlay-title="Move workspace down" { move-workspace-down; }
    Mod+Shift+Page_Up   hotkey-overlay-title="Move workspace up" { move-workspace-up; }

    Mod+1 hotkey-overlay-title="Focus workspace (1-9)" { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 hotkey-overlay-title="Move window to workspace (1-9)" { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    Mod+Ctrl+1 hotkey-overlay-title="Move column to workspace (1-9)" { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Apps such as remote-desktop clients and software KVM switches may request
    // that niri stops processing the keyboard shortcuts defined here so they
    // may, for example, forward the key presses as-is to a remote machine.
    // It's a good idea to bind an escape hatch to toggle the inhibitor, so a
    // buggy application can't hold your session hostage.
    //
    // allow-inhibiting=false can be applied to other binds as well, which
    // ensures niri always processes them, even when an inhibitor is active.
    Mod+Escape allow-inhibiting=false hotkey-overlay-title="Always process even with inhibitor" { toggle-keyboard-shortcuts-inhibit; }

    // Clipboard visual
    Mod+Shift+V hotkey-overlay-title="Clipboard history" { spawn "/usr/bin/copyq" "toggle"; }

    // Power menu
    Mod+Shift+Delete hotkey-overlay-title="Power menu" { spawn "/home/goncalom/.local/bin/power-menu"; }
}

// ----------------------------------------------------------------------------
// Theme and personalized configs
// ----------------------------------------------------------------------------

include "theme.kdl"
include "config.kdl.local"

    // Clipboard visual

    // Power menu
