{
  "layer": "top",
  "height": 32,
  "spacing": 4,
  "modules-left": [
    "niri/workspaces",
    "niri/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "idle_inhibitor",
    "pulseaudio",
    "network",
    "bluetooth",
    "cpu",
    "memory",
    "battery"
  ],
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },
  "niri/window": {
    "max-length": 50
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %d %B %Y}",
    "tooltip-format": "<span color='#89b4fa' size='xx-large'><b>{:%B %Y}</b></span>\n\n<tt><span size='large'>\n{calendar}\n</span></tt>\n\n<span color='#a6e3a1'>Hoje: {:%A, %d %B %Y}</span>\n<span color='#f9e2af'>Semana {:%V}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": null,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#f38ba8' size='x-large'><b>{}</b></span>",
        "days": "<span color='#cdd6f4' size='large'>{}</span>",
        "weeks": "<span color='#a6e3a1'>W{}</span>",
        "weekdays": "<span color='#f9e2af' size='large'><b>{}</b></span>",
        "today": "<span color='#f38ba8' size='x-large'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": " {icon}",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": " {ifname}",
    "format-disconnected": "",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "",
    "format-connected": " {num_connections}",
    "on-click": "blueman-manager"
  },
  "cpu": {
    "format": " {usage}%",
    "tooltip": true,
    "on-click": "ghostty -e btop",
    "interval": 2
  },
  "memory": {
    "format": " {percentage}%",
    "tooltip": true,
    "on-click": "ghostty -e btop",
    "interval": 5
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "on-click": "ghostty -e btop"
  }
}